# Copy to .env and fill in. docker compose reads .env automatically.

# Required: bearer token guarding every /v1 route (and /metrics).
# Generate one: openssl rand -hex 32
RUWA_API_TOKEN=

# Optional: enable AES-256-GCM encryption at rest for the sensitive DB columns.
# Must be 32 bytes, base64-encoded. Generate one: openssl rand -base64 32
# Leave blank to store unencrypted (e.g. when the volume is on an encrypted disk).
RUWA_DB_ENCRYPTION_KEY=

# Optional: log level (error|warn|info|debug|trace).
RUST_LOG=info

# Optional: WhatsApp Web client version override ("a.b.c", all numeric). If
# WhatsApp starts rejecting logins with <failure reason="405"> ("client
# outdated"), set this to a current WA Web version without rebuilding.
# RUWA_WA_VERSION=

# Optional but RECOMMENDED for agent/MCP deployments: confine `POST
# /messages/media` file_path sends to this directory. When set, a file_path
# resolving outside it is rejected (blocks path-traversal / file exfiltration
# under prompt injection). Unset = full-filesystem access (operator's choice).
# RUWA_MEDIA_BASE_DIR=/srv/ruwa/media
# Max HTTP request body for /v1/* (MB). Bounds multipart uploads / base64 sends.
# RUWA_BODY_LIMIT_MB=20

# Optional: cross-instance leasing (set RUWA_LEASING=1 to enable).
# RUWA_LEASING=1
# RUWA_INSTANCE_ID=
# RUWA_LEASE_TTL_SECS=60

# Optional: retention sweep (all default off).
# RUWA_RETENTION_SWEEP_SECS=21600
# RUWA_RETENTION_MESSAGES_PER_CHAT=5000
# RUWA_RETENTION_MESSAGE_DAYS=90
# RUWA_RETENTION_SIGNAL_DAYS=180

# Optional: media storage. Default "db" keeps media blobs in the database.
# Set "s3" to offload to an S3-compatible bucket (MinIO/AWS S3/Cloudflare R2)
# via the in-house SigV4 client; the RUWA_S3_* vars are then required.
# RUWA_MEDIA_STORE=s3
# RUWA_S3_ENDPOINT=http://minio:9000
# RUWA_S3_BUCKET=wa-media
# RUWA_S3_REGION=us-east-1
# RUWA_S3_ACCESS_KEY=
# RUWA_S3_SECRET_KEY=
# Public base URL for serving objects (CDN / R2). Falls back to
# {endpoint}/{bucket}/{key} path-style when unset.
# RUWA_S3_PUBLIC_BASE_URL=

# Optional: enable the modern LID 1:1 stanza (addressing_mode/phash/peer_recipient_pn).
# Off by default — some servers reject it (error 479) for migrated peers, so the
# default legacy stanza is what delivers. Only flip this if you know you need it.
# RUWA_MODERN_LID_SEND=1

# Optional: egress-proxy bandwidth savers (both default ON = safe behavior).
# Set RUWA_PROXY_DOWNLOADS=0 to route media + history-sync DOWNLOADS direct
# (off the session's metered proxy); socket + uploads always stay on the proxy.
# RUWA_PROXY_DOWNLOADS=0
# QR-window refreshes an unpaired session may burn per connect before parking
# disconnected (each ≈20–40s; default 8 ≈ 4–5 min). Bounds proxy spend on an
# abandoned QR.
# RUWA_QR_MAX_REFRESHES=8
# Heavy ingests (history-sync blobs, app-state snapshots) allowed at once.
# Default 1 serializes them so parallel pairings can't stack multi-GB peaks.
# RUWA_HEAVY_INGEST_CONCURRENCY=1
# Set RUWA_SKIP_REDUNDANT_HISTORY=0 to disable the gate that skips re-downloading
# heavy history-sync chunks (BOOTSTRAP/FULL/RECENT) re-pushed on reconnect.
# RUWA_SKIP_REDUNDANT_HISTORY=0

# Optional: Meta WhatsApp Cloud API backend (sessions created with "kind":"cloud").
# Verify token Meta sends on the webhook subscription handshake
# (GET /v1/cloud/webhook?hub.mode=subscribe&hub.verify_token=...). Paste the same
# value in the Meta app's Webhook config. Unset = any cloud session's own
# verify_token is accepted.
# RUWA_CLOUD_VERIFY_TOKEN=
# Set to 1 to accept webhooks for cloud sessions created WITHOUT an app_secret
# (skips the X-Hub-Signature-256 HMAC check). Off by default: unsigned deliveries
# are rejected with 401. Only for local testing.
# RUWA_CLOUD_ALLOW_UNSIGNED=1

# Optional: Kapso Business Platform provider for "kind":"cloud" sessions
# (cloud.provider = "kapso"). ruwa acts as a BSP: the operator sends the customer
# a hosted setup link, the customer completes Meta embedded-signup on Kapso, and
# a Kapso project-webhook tells ruwa the number is live.
# Platform API key — authenticates every Kapso call (the WhatsApp meta-compat
# proxy + the Platform API). REQUIRED for any kapso session.
# RUWA_KAPSO_API_KEY=
# This ruwa's public https origin. REQUIRED for kapso — used to build the webhook
# URLs (/v1/cloud/kapso/webhook, /v1/cloud/kapso/project-webhook) registered with
# Kapso, so ruwa must be reachable from the internet over HTTPS.
# RUWA_PUBLIC_BASE_URL=https://ruwa.example.com
# Optional: Kapso API base URL (default https://api.kapso.ai; the /meta/whatsapp
# and /platform/v1 paths are derived from it).
# RUWA_KAPSO_BASE_URL=https://api.kapso.ai
# Optional: shared secret Kapso uses to sign the project webhook
# (X-Webhook-Signature over the raw body). Unset = project-webhook signature not
# enforced.
# RUWA_KAPSO_PROJECT_WEBHOOK_SECRET=
